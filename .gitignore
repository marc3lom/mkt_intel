# --- Saídas do plantão -------------------------------------------------------
# Painel e calendário gerados por scripts/gera_painel.py: reconstruíveis a cada
# manhã a partir do terminal Bloomberg, e sem valor de histórico no repositório.
painel.txt

# Fontes do dia e comentários exportados em PDF.
*.pdf

# Comentários exportados em Word. O arquivo versionado é o texto
# (arquivo/AAAA/MM/AAAAMMDD.md); o .docx é subproduto de envio e não gera diff útil.
*.docx

# --- Segredos e configuração local -------------------------------------------
.env
.env.*
!.env.example
!.env.tpl

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- uv / ambiente virtual ---------------------------------------------------
.venv/
venv/
# uv.lock é versionado de propósito: garante que o plantão rode com as mesmas
# versões em qualquer máquina. Não adicionar aqui.

# --- Ferramentas de teste e tipagem ------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editores e ferramentas --------------------------------------------------
.claude/settings.local.json
.vscode/
.idea/
.ipynb_checkpoints/

# --- Sistema operacional -----------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
~$*.docx
~$*.doc

# --- Entrada e saída do dia --------------------------------------------------
# Tudo o que entra (PDFs das fontes, documentos do Fed, planilhas de e-mail) e
# tudo o que sai (painel, calendário, etapas, .docx, gráficos). Ancoradas: só as
# duas pastas da raiz, inteiras, sem exceção. O registro versionado do que foi
# enviado é arquivo/, que não mora aqui de propósito.
/input/
/output/
